{
  "name": "singapore-food-tracker-vue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm run dev:api\" \"pnpm run dev:web\"",
    "dev:api": "node api/dev.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "vercel-build": "node database/migrate.js && vite build",
    "migrate": "node database/migrate.js",
    "db:migrate": "node database/migrate.js",
    "lint": "eslint . --ext .vue,.js",
    "lint:fix": "eslint . --ext .vue,.js --fix"
  },
  "dependencies": {
    "@vercel/blob": "^2.3.3",
    "axios": "^1.12.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "google-auth-library": "^11.0.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "pg": "^8.12.0",
    "vue": "^3.5.18"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "eslint": "^9.36.0",
    "eslint-plugin-vue": "^10.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.6",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vue-eslint-parser": "^10.2.0"
  }
}
